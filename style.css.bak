
:root{
  --paper:#f7f5f1;
  --rail:#f1efeb;
  --ink:#24221f;
  --body:#68635d;
  --muted:#8a847d;
  --line:#d8d4ce;
  --soft:#ebe8e3;
  --accent:#5f5a55;
  --rail-width:214px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--body);
  font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:16px;
  line-height:1.6;
}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}

.rail{
  position:fixed;
  inset:0 auto 0 0;
  width:var(--rail-width);
  background:var(--rail);
  border-right:1px solid var(--line);
  z-index:20;
}
.rail-inner{
  height:100%;
  padding:30px 26px 26px;
  display:flex;
  flex-direction:column;
}
.rail-name{
  color:var(--ink);
  font-family:"Space Grotesk",sans-serif;
  font-size:25px;
  font-weight:600;
  letter-spacing:-.01em;
  margin-bottom:48px;
}
.rail-nav{
  display:flex;
  flex-direction:column;
  gap:10px;
}
.rail-nav a{
  width:max-content;
  color:#7d7770;
  font-size:12.5px;
  font-weight:500;
  letter-spacing:.01em;
}
.rail-nav a:hover{color:var(--ink)}
.rail-footer{
  margin-top:auto;
  padding-top:24px;
  border-top:1px solid var(--line);
}
.rail-footer a{
  font-size:11.5px;
  color:var(--muted);
}

.site{
  margin-left:var(--rail-width);
  min-height:100vh;
}
.section{
  width:min(1180px, calc(100vw - var(--rail-width) - 72px));
  margin:0 auto;
  padding:92px 0 104px;
  border-bottom:1px solid var(--line);
}
.hero{
  min-height:88vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.eyebrow,.kicker{
  font-size:11px;
  line-height:1.3;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--muted);
}
.hero h1,
.section h2,
.feature h3,
.technical-item h3,
.recognition-copy h3{
  font-family:"Space Grotesk",sans-serif;
  color:var(--ink);
  font-weight:600;
  letter-spacing:-.025em;
}
.hero h1{
  font-size:clamp(72px,9vw,132px);
  line-height:.9;
  margin:18px 0 28px;
}
.hero-deck{
  max-width:760px;
  font-size:23px;
  line-height:1.45;
  color:#4d4944;
  margin:0 0 34px;
}
.hero-meta{
  display:flex;
  gap:28px;
  font-size:12px;
  color:var(--muted);
}

.section-heading{
  display:grid;
  grid-template-columns:48px minmax(0,1fr) minmax(260px,380px);
  gap:18px;
  align-items:end;
  margin-bottom:46px;
}
.section-index{
  font-size:11px;
  color:var(--muted);
  padding-bottom:9px;
}
.section-heading h2{
  margin:0;
  font-size:56px;
  line-height:.95;
}
.section-heading p{
  margin:0;
  font-size:13.5px;
  line-height:1.6;
  color:var(--muted);
}

.feature-list{
  display:flex;
  flex-direction:column;
  gap:72px;
}
.feature{
  display:block;
}
.feature-image{
  width:100%;
  aspect-ratio:16/8.6;
}
.feature-caption{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(260px,390px);
  gap:28px;
  padding:19px 0 0;
}
.feature h3{
  margin:4px 0 0;
  font-size:42px;
  line-height:1;
}
.feature-caption p{
  margin:1px 0 0;
  font-size:13px;
  line-height:1.55;
  color:var(--muted);
}
.feature:hover h3{font-style:italic}

.placeholder{
  background:var(--soft);
  border:1px solid var(--line);
  color:#9a948d;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  font-size:11px;
  font-weight:600;
  letter-spacing:.10em;
}

.technical-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:48px 34px;
}
.technical-media{
  aspect-ratio:4/3;
  margin-bottom:14px;
}
.technical-item h3{
  font-size:30px;
  line-height:1;
  margin:0 0 4px;
}
.technical-item .role{
  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
  margin:0 0 6px;
}
.technical-item p:last-child{
  font-size:12.5px;
  color:var(--muted);
  margin:0;
}

.recognition-list{
  display:flex;
  flex-direction:column;
  gap:38px;
}
.recognition-row{
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:44px;
  align-items:center;
}
.recognition-row.reverse .recognition-media{order:2}
.recognition-row.reverse .recognition-copy{order:1}
.recognition-media{
  height:290px;
}
.recognition-copy h3{
  font-size:40px;
  line-height:1;
  margin:6px 0 12px;
}
.recognition-copy p{
  max-width:360px;
  font-size:13px;
  color:var(--muted);
  margin:0;
}

.sketch-grid{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  grid-auto-rows:120px;
  gap:16px;
}
.sketch{grid-column:span 4;grid-row:span 2}
.sketch-wide{grid-column:span 8}
.sketch-tall{grid-row:span 3}

.cv-section{
  min-height:58vh;
}
.cv-copy{
  max-width:600px;
  font-size:18px;
}
.text-link{
  display:inline-block;
  margin-top:14px;
  padding-bottom:2px;
  border-bottom:1px solid var(--ink);
  color:var(--ink);
  font-size:13px;
}

/* DETAIL PAGES */
.detail-shell{
  margin-left:var(--rail-width);
}
.detail-page{
  width:min(1320px, calc(100vw - var(--rail-width) - 72px));
  margin:0 auto;
  padding:66px 0 100px;
}
.detail-head{
  display:grid;
  grid-template-columns:1fr minmax(280px,420px);
  gap:40px;
  align-items:end;
  margin-bottom:30px;
}
.detail-index{
  font-size:11px;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:8px;
}
.detail-title{
  margin:0;
  color:var(--ink);
  font-family:"Space Grotesk",sans-serif;
  font-size:clamp(58px,7.6vw,108px);
  line-height:.9;
  font-weight:600;
  letter-spacing:-.035em;
}
.detail-deck{
  margin:0;
  font-size:15px;
  line-height:1.65;
  color:var(--muted);
}
.detail-hero{
  width:100%;
  aspect-ratio:16/8.8;
  margin:34px 0 46px;
}
.detail-info{
  display:grid;
  grid-template-columns:1.45fr .65fr;
  gap:64px;
  padding:34px 0 40px;
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}
.info-block{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:28px 36px;
}
.info-unit h3,.meta-unit h3{
  margin:0 0 7px;
  color:var(--ink);
  font-size:11px;
  font-weight:600;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.info-unit p,.meta-unit p{
  margin:0;
  font-size:13.5px;
  color:var(--body);
}
.meta-stack{
  display:flex;
  flex-direction:column;
  gap:18px;
}
.story-stack{
  margin-top:18px;
}
.story-row{
  display:grid;
  grid-template-columns:1.25fr .75fr;
  gap:54px;
  align-items:center;
  padding:56px 0;
  border-bottom:1px solid var(--line);
}
.story-row.reverse{
  grid-template-columns:.75fr 1.25fr;
}
.story-row.reverse .story-media{order:2}
.story-row.reverse .story-copy{order:1}
.story-media{
  aspect-ratio:4/3;
}
.story-copy .kicker{margin-bottom:10px}
.story-copy h2{
  margin:0 0 14px;
  color:var(--ink);
  font-family:"Space Grotesk",sans-serif;
  font-size:44px;
  line-height:1;
  font-weight:600;
  letter-spacing:-.02em;
}
.story-copy p{
  margin:0;
  font-size:14px;
  line-height:1.7;
  color:var(--muted);
}
.detail-final{
  padding-top:58px;
}
.detail-final-media{
  aspect-ratio:16/8.8;
}
.detail-caption{
  width:min(620px,100%);
  font-size:12px;
  color:var(--muted);
  margin-top:10px;
}

@media(max-width:980px){
  :root{--rail-width:0px}
  .rail{
    position:static;
    width:auto;
    border-right:0;
    border-bottom:1px solid var(--line);
  }
  .rail-inner{
    height:auto;
    padding:18px 20px;
  }
  .rail-name{margin:0 0 14px}
  .rail-nav{
    flex-direction:row;
    flex-wrap:wrap;
    gap:8px 16px;
  }
  .rail-footer{display:none}
  .site,.detail-shell{margin-left:0}
  .section,.detail-page{
    width:calc(100vw - 36px);
    padding-left:0;
    padding-right:0;
  }
  .section-heading{
    grid-template-columns:32px 1fr;
  }
  .section-heading p{
    grid-column:2;
  }
  .feature-caption{
    grid-template-columns:1fr;
  }
  .technical-grid{
    grid-template-columns:1fr;
  }
  .recognition-row,.recognition-row.reverse{
    grid-template-columns:1fr;
    gap:16px;
  }
  .recognition-row.reverse .recognition-media,
  .recognition-row.reverse .recognition-copy{
    order:initial;
  }
  .recognition-media{height:auto;aspect-ratio:16/9}
  .detail-head{
    grid-template-columns:1fr;
  }
  .detail-info{
    grid-template-columns:1fr;
  }
  .story-row,.story-row.reverse{
    grid-template-columns:1fr;
    gap:22px;
  }
  .story-row.reverse .story-media,
  .story-row.reverse .story-copy{order:initial}
}


/* ============================================================
   V11 RESEARCH EDITORIAL SYSTEM
   Warm paper + technical / research typography
   Space Grotesk = display
   Inter = body
   IBM Plex Mono = metadata / system labels
   ============================================================ */

:root{
  --paper:#f7f5f1;
  --rail:#f1efeb;
  --ink:#242424;
  --body:#625f5b;
  --muted:#89837c;
  --line:#d6d1cb;
  --soft:#ebe7e1;
  --accent:#55514d;
}

body{
  font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:var(--body);
  background:var(--paper);
}

.mono,
.meta-label,
.detail-index,
.kicker,
.eyebrow{
  font-family:"IBM Plex Mono",monospace !important;
  letter-spacing:.08em;
}

.rail-name,
.hero h1,
.section h2,
.feature h3,
.technical-item h3,
.recognition-copy h3,
.detail-title,
.story-copy h2{
  font-family:"Space Grotesk",sans-serif !important;
  letter-spacing:-.035em;
}

.rail-name{
  font-size:21px;
  font-weight:600;
  letter-spacing:-.02em;
}

.rail-nav a{
  font-family:"IBM Plex Mono",monospace;
  font-size:11px;
  letter-spacing:.02em;
}

.hero{
  min-height:88vh;
}

.hero-grid{
  display:grid;
  grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);
  gap:64px;
  align-items:end;
}

.hero h1{
  font-size:clamp(72px,8.4vw,120px);
  line-height:.92;
  font-weight:500;
  margin:14px 0 10px;
  text-transform:none;
}

.hero-role{
  font-family:"IBM Plex Mono",monospace;
  font-size:13px;
  color:var(--muted);
  margin:0 0 36px;
}

.hero-question{
  max-width:820px;
  margin:0;
  color:var(--ink);
  font-size:clamp(28px,3.2vw,46px);
  line-height:1.16;
  font-family:"Space Grotesk",sans-serif;
  font-weight:400;
  letter-spacing:-.035em;
}

.hero-research{
  border-left:1px solid var(--line);
  padding-left:24px;
  display:flex;
  flex-direction:column;
  gap:28px;
}

.meta-block p{
  margin:4px 0 0;
  font-size:13px;
  color:var(--body);
}

.meta-label{
  display:block;
  font-size:10px;
  line-height:1.3;
  font-weight:600;
  color:var(--muted);
  text-transform:uppercase;
}

.section-heading{
  grid-template-columns:48px minmax(0,1fr) minmax(260px,380px);
}

.section-heading h2{
  font-size:52px;
  font-weight:500;
  letter-spacing:-.04em;
}

.section-index{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
}

.feature-caption{
  grid-template-columns:minmax(0,.7fr) minmax(420px,1.3fr);
  gap:40px;
  align-items:start;
}

.feature h3{
  font-size:38px;
  font-weight:500;
}

.feature-meta{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding-top:2px;
}

.feature-meta > div{
  display:grid;
  grid-template-columns:72px minmax(0,1fr);
  gap:14px;
  align-items:start;
  font-size:12.5px;
  line-height:1.45;
  color:var(--muted);
}

.feature-meta .meta-label{
  margin-top:1px;
}

.technical-item .role,
.recognition-copy .kicker,
.story-copy .kicker{
  font-family:"IBM Plex Mono",monospace !important;
  letter-spacing:.06em;
}

.placeholder{
  background:#ece8e2;
  border:1px solid var(--line);
}

.detail-head{
  grid-template-columns:1.15fr minmax(340px,.85fr);
}

.detail-title{
  font-size:clamp(58px,6.8vw,98px);
  font-weight:500;
}

.detail-deck{
  font-size:14px;
}

.detail-info{
  grid-template-columns:1.5fr .6fr;
}

.info-unit h3,
.meta-unit h3{
  font-family:"IBM Plex Mono",monospace;
  letter-spacing:.07em;
}

.story-copy h2{
  font-weight:500;
  letter-spacing:-.035em;
}

@media(max-width:980px){
  .hero-grid{
    grid-template-columns:1fr;
    gap:36px;
  }

  .hero-research{
    border-left:0;
    border-top:1px solid var(--line);
    padding-left:0;
    padding-top:22px;
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .feature-caption{
    grid-template-columns:1fr;
  }

  .feature-meta > div{
    grid-template-columns:68px 1fr;
  }
}


/* ============================================================
   V12 — SAGE / LAB EDITORIAL
   More legible, less "cute", slightly more research-lab.
   IBM Plex Sans + IBM Plex Mono.
   ============================================================ */

:root{
  --paper:#f5f4ef;
  --rail:#e8ebe5;
  --ink:#232724;
  --body:#5f645f;
  --muted:#7f857f;
  --line:#cfd4cd;
  --soft:#e9ece6;
  --accent:#667066;
}

body{
  background:var(--paper) !important;
  color:var(--body) !important;
  font-family:"IBM Plex Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif !important;
}

.rail{
  background:var(--rail) !important;
  border-right:1px solid var(--line) !important;
}

.rail-name,
.hero h1,
.section h2,
.feature h3,
.technical-item h3,
.recognition-copy h3,
.detail-title,
.story-copy h2,
.hero-question{
  font-family:"IBM Plex Sans",sans-serif !important;
  color:var(--ink) !important;
  letter-spacing:-.025em !important;
}

.rail-name{
  font-size:20px !important;
  font-weight:600 !important;
}

.hero h1{
  font-weight:600 !important;
  font-size:clamp(68px,7.6vw,108px) !important;
  line-height:.95 !important;
}

.hero-question{
  font-weight:500 !important;
  max-width:780px !important;
  font-size:clamp(26px,2.8vw,40px) !important;
  line-height:1.18 !important;
}

.section-heading h2{
  font-size:48px !important;
  font-weight:600 !important;
}

.feature h3{
  font-size:34px !important;
  font-weight:600 !important;
}

.detail-title{
  font-weight:600 !important;
}

.story-copy h2{
  font-weight:600 !important;
}

.mono,
.meta-label,
.detail-index,
.kicker,
.eyebrow,
.rail-nav a,
.technical-item .role,
.recognition-copy .kicker,
.story-copy .kicker,
.info-unit h3,
.meta-unit h3{
  font-family:"IBM Plex Mono",monospace !important;
}

.rail-nav a{
  font-size:10.8px !important;
  color:#70766f !important;
}

.rail-nav a:hover{
  color:var(--ink) !important;
}

a{
  color:var(--accent) !important;
}

a:hover{
  color:var(--ink) !important;
}

.placeholder{
  background:var(--soft) !important;
  border-color:var(--line) !important;
  color:#939a92 !important;
}

/* --- project metadata: clearly pushed right --- */

.feature-caption{
  display:grid !important;
  grid-template-columns:minmax(240px,.62fr) minmax(520px,1.38fr) !important;
  gap:76px !important;
  padding-top:20px !important;
  align-items:start !important;
}

.feature-meta{
  margin-left:auto !important;
  width:min(100%,620px) !important;
  padding-left:34px !important;
  border-left:1px solid var(--line) !important;
  gap:10px !important;
}

.feature-meta > div{
  display:grid !important;
  grid-template-columns:86px minmax(0,1fr) !important;
  gap:18px !important;
  font-size:13.5px !important;
  line-height:1.5 !important;
  color:#656b65 !important;
}

.feature-meta .meta-label{
  font-size:10px !important;
  font-weight:600 !important;
  color:#7e857e !important;
}

.feature-caption .kicker{
  color:#818781 !important;
}

/* clearer body / meta hierarchy */
.section-heading p,
.feature-meta,
.technical-item p:last-child,
.recognition-copy p,
.detail-deck,
.story-copy p{
  color:#6b716b !important;
}

.meta-block p,
.info-unit p,
.meta-unit p{
  color:#5f645f !important;
}

/* slightly more technical grid feel */
.section,
.detail-info,
.story-row,
.feature,
.recognition-row{
  border-color:var(--line) !important;
}

@media(max-width:980px){
  .feature-caption{
    grid-template-columns:1fr !important;
    gap:18px !important;
  }

  .feature-meta{
    margin-left:0 !important;
    width:100% !important;
    padding-left:0 !important;
    padding-top:16px !important;
    border-left:0 !important;
    border-top:1px solid var(--line) !important;
  }
}


/* ============================================================
   V12.1 — NEUTRAL PAPER + TINY SAGE ACCENT
   The overall page is neutral so artwork colors stay unaffected.
   Sage is used only for subtle technical accents.
   ============================================================ */

:root{
  --paper-neutral:#f7f6f3;
  --rail-neutral:#ecece8;
  --ink-neutral:#242424;
  --body-neutral:#66635f;
  --muted-neutral:#88837d;
  --line-neutral:#d8d6d1;
  --soft-neutral:#eeece8;

  --sage-accent:#6f786f;
  --sage-accent-soft:#9aa29a;
}

body{
  background:var(--paper-neutral) !important;
  color:var(--body-neutral) !important;
}

.rail{
  background:var(--rail-neutral) !important;
  border-right-color:var(--line-neutral) !important;
}

.rail-name,
.hero h1,
.section h2,
.feature h3,
.technical-item h3,
.recognition-copy h3,
.detail-title,
.story-copy h2,
.hero-question{
  color:var(--ink-neutral) !important;
}

.rail-nav a{
  color:#76726d !important;
}

.rail-nav a:hover{
  color:var(--ink-neutral) !important;
}

a{
  color:var(--ink-neutral) !important;
}

a:hover{
  color:var(--sage-accent) !important;
}

.placeholder{
  background:var(--soft-neutral) !important;
  border-color:var(--line-neutral) !important;
  color:#97928c !important;
}

/* Sage only as a micro-accent */
.meta-label,
.eyebrow,
.kicker,
.detail-index,
.feature-caption .kicker,
.recognition-copy .kicker,
.story-copy .kicker,
.info-kicker,
.small-meta{
  color:var(--sage-accent) !important;
}

.feature-meta{
  border-left-color:var(--sage-accent-soft) !important;
}

.feature-meta .meta-label{
  color:var(--sage-accent) !important;
}

.section,
.detail-info,
.story-row,
.feature,
.recognition-row,
#projects .card,
#experiments .card{
  border-color:var(--line-neutral) !important;
}

.hero-research{
  border-left-color:var(--line-neutral) !important;
}

.meta-block p,
.info-unit p,
.meta-unit p,
.section-heading p,
.feature-meta > div,
.technical-item p:last-child,
.recognition-copy p,
.detail-deck,
.story-copy p{
  color:var(--body-neutral) !important;
}

/* Make current / technical labels slightly more restrained */
.meta-label,
.kicker,
.eyebrow,
.detail-index{
  font-weight:500 !important;
}

/* Current navigation can use a tiny sage cue without tinting the whole rail */
.rail-nav a.current,
.rail-nav a[aria-current="page"]{
  color:var(--sage-accent) !important;
}


/* ============================================================
   V12.2 — WHITE / MAXIMUM NEUTRAL
   Pure white canvas, neutral grayscale UI, no color accent.
   Designed to let lighting / theatre images carry all color.
   ============================================================ */

:root{
  --white:#ffffff;
  --rail-white:#fafafa;
  --ink:#202020;
  --body:#5f5f5f;
  --muted:#858585;
  --line:#dddddd;
  --soft:#f2f2f2;
  --soft-2:#f7f7f7;
}

body{
  background:var(--white) !important;
  color:var(--body) !important;
}

.rail{
  background:var(--rail-white) !important;
  border-right:1px solid var(--line) !important;
}

.rail-name,
.hero h1,
.section h2,
.feature h3,
.technical-item h3,
.recognition-copy h3,
.detail-title,
.story-copy h2,
.hero-question{
  color:var(--ink) !important;
}

.rail-nav a{
  color:#777 !important;
}

.rail-nav a:hover,
.rail-nav a.current,
.rail-nav a[aria-current="page"]{
  color:var(--ink) !important;
}

a{
  color:var(--ink) !important;
}

a:hover{
  color:#555 !important;
}

.placeholder{
  background:var(--soft) !important;
  border-color:var(--line) !important;
  color:#969696 !important;
}

.meta-label,
.eyebrow,
.kicker,
.detail-index,
.feature-caption .kicker,
.recognition-copy .kicker,
.story-copy .kicker,
.info-kicker,
.small-meta{
  color:#777 !important;
}

.feature-meta{
  border-left-color:var(--line) !important;
}

.feature-meta .meta-label{
  color:#777 !important;
}

.section,
.detail-info,
.story-row,
.feature,
.recognition-row,
#projects .card,
#experiments .card{
  border-color:var(--line) !important;
}

.hero-research{
  border-left-color:var(--line) !important;
}

.meta-block p,
.info-unit p,
.meta-unit p,
.section-heading p,
.feature-meta > div,
.technical-item p:last-child,
.recognition-copy p,
.detail-deck,
.story-copy p{
  color:var(--body) !important;
}

/* Slightly crisper research-document feel */
.section-index,
.meta-label,
.kicker,
.eyebrow,
.detail-index{
  color:#6d6d6d !important;
}

.hero-role{
  color:#777 !important;
}

.text-link{
  border-bottom-color:var(--ink) !important;
}

/* reduce decorative tinting everywhere */
::selection{
  background:#e9e9e9;
  color:#111;
}


/* ============================================================
   V12.4 — SAME WEIGHT, SOFTER HEADING COLOR
   Keep original heading weights; only soften the color slightly.
   ============================================================ */

:root{
  --heading-soft:#343434;
  --heading-soft-2:#383838;
}

/* Keep existing font weights from V12.2 */
.hero h1,
.feature h3,
.technical-item h3,
.recognition-copy h3,
.detail-title,
.story-copy h2,
.hero-question,
.rail-name{
  color:var(--heading-soft) !important;
}

.section h2{
  color:var(--heading-soft-2) !important;
}

/* Do not alter font-weight here */


/* ============================================================
   V12.5 — HOVER REFINEMENT
   Remove italic hover; use subtle neutral color rollover instead.
   ============================================================ */

.feature:hover h3{
  font-style:normal !important;
  color:#6a6a6a !important;
}

.feature h3{
  transition:color .18s ease;
}

/* Keep links subtle and neutral on hover */
.feature:hover .feature-meta,
.feature:hover .kicker{
  color:inherit !important;
}


/* ============================================================
   V13 — MIT / CRITICAL MATTER DETAIL PAGE SYSTEM
   Main homepage remains unchanged.
   Projects and Experiments now use distinct research-story layouts.
   ============================================================ */

/* Shared detail shell */
.case-shell{
  margin-left:var(--rail-width);
}

.case-page{
  width:min(1320px, calc(100vw - var(--rail-width) - 72px));
  margin:0 auto;
  padding:66px 0 110px;
}

.case-back{
  display:inline-block;
  margin-bottom:36px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#777 !important;
}

.case-kicker{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.09em;
  text-transform:uppercase;
  color:#777;
  margin-bottom:10px;
}

.case-title{
  margin:0;
  color:#343434;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:clamp(58px,7.2vw,104px);
  line-height:.92;
  font-weight:600;
  letter-spacing:-.035em;
}

.case-question{
  max-width:860px;
  margin:28px 0 0;
  color:#4e4e4e;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:clamp(24px,2.7vw,39px);
  line-height:1.2;
  font-weight:400;
  letter-spacing:-.02em;
}

.case-hero{
  width:100%;
  aspect-ratio:16/8.7;
  margin:44px 0 48px;
}

.case-meta{
  display:grid;
  grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);
  gap:58px;
  padding:34px 0 40px;
  border-top:1px solid #dedede;
  border-bottom:1px solid #dedede;
}

.case-meta-main{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:30px 40px;
}

.case-meta-side{
  display:flex;
  flex-direction:column;
  gap:18px;
}

.case-unit h3,
.case-side-unit h3{
  margin:0 0 6px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  font-weight:600;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#777;
}

.case-unit p,
.case-side-unit p{
  margin:0;
  font-size:13.5px;
  line-height:1.65;
  color:#606060;
}

/* PROJECT PAGES ------------------------------------------------ */

.project-block{
  padding:62px 0;
  border-bottom:1px solid #dedede;
}

.project-block-head{
  display:grid;
  grid-template-columns:220px minmax(0,1fr);
  gap:44px;
  margin-bottom:28px;
}

.project-block-number{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#888;
  padding-top:7px;
}

.project-block-copy h2{
  margin:0 0 12px;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:36px;
  line-height:1.08;
  font-weight:600;
  letter-spacing:-.025em;
  color:#383838;
}

.project-block-copy p{
  margin:0;
  max-width:760px;
  font-size:14px;
  line-height:1.75;
  color:#606060;
}

.project-visual-split{
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);
  gap:28px;
  align-items:start;
}

.project-visual{
  aspect-ratio:4/3;
}

.annotation-box{
  border-top:1px solid #dedede;
  padding-top:14px;
}

.annotation-box h3{
  margin:0 0 10px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#777;
}

.annotation-box ol{
  margin:0;
  padding-left:18px;
  color:#606060;
  font-size:13px;
  line-height:1.75;
}

.sequence-strip{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
}

.sequence-frame{
  aspect-ratio:4/3;
}

.sequence-label{
  margin-top:8px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  color:#777;
}

.reflection-grid{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(300px,.65fr);
  gap:52px;
}

.reflection-quote{
  font-family:"IBM Plex Sans",sans-serif;
  font-size:26px;
  line-height:1.3;
  color:#454545;
  letter-spacing:-.02em;
}

.reflection-next{
  border-left:1px solid #dedede;
  padding-left:24px;
}

.reflection-next h3{
  margin:0 0 8px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#777;
}

.reflection-next p{
  margin:0;
  font-size:13.5px;
  line-height:1.7;
  color:#606060;
}

/* EXPERIMENT PAGES --------------------------------------------- */

.experiment-question-band{
  display:grid;
  grid-template-columns:150px minmax(0,1fr);
  gap:42px;
  padding:30px 0 34px;
  border-top:1px solid #dedede;
  border-bottom:1px solid #dedede;
  margin-bottom:48px;
}

.experiment-question-band .label{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  color:#777;
  text-transform:uppercase;
  padding-top:6px;
}

.experiment-question-band p{
  margin:0;
  font-size:25px;
  line-height:1.35;
  color:#444;
}

.experiment-section{
  padding:58px 0;
  border-bottom:1px solid #dedede;
}

.experiment-heading{
  display:grid;
  grid-template-columns:150px minmax(0,1fr);
  gap:42px;
  margin-bottom:28px;
}

.experiment-heading .num{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  color:#888;
  letter-spacing:.08em;
  text-transform:uppercase;
  padding-top:7px;
}

.experiment-heading h2{
  margin:0;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:36px;
  line-height:1.08;
  font-weight:600;
  color:#383838;
  letter-spacing:-.025em;
}

.apparatus-grid{
  display:grid;
  grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);
  gap:30px;
  align-items:start;
}

.apparatus-image{
  aspect-ratio:4/3;
}

.apparatus-list{
  padding-top:2px;
}

.apparatus-list ol{
  margin:0;
  padding-left:20px;
  font-size:13px;
  line-height:1.8;
  color:#606060;
}

.system-diagram{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  align-items:center;
  gap:10px;
}

.system-node{
  min-height:110px;
  border:1px solid #dcdcdc;
  background:#fafafa;
  padding:16px 12px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.system-node .node-label{
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;
  text-transform:uppercase;
  color:#888;
  margin-bottom:7px;
}

.system-node strong{
  font-size:13px;
  color:#484848;
  font-weight:500;
}

.system-arrow{
  text-align:center;
  color:#aaa;
  font-size:16px;
}

.iteration-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:28px;
}

.iteration-card{
  border-top:1px solid #dedede;
  padding-top:14px;
}

.iteration-card .iteration-label{
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  color:#777;
  letter-spacing:.08em;
  margin-bottom:10px;
}

.iteration-image{
  aspect-ratio:4/3;
  margin-bottom:14px;
}

.iteration-meta{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}

.iteration-meta h3{
  margin:0 0 5px;
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;
  letter-spacing:.07em;
  text-transform:uppercase;
  color:#888;
}

.iteration-meta p{
  margin:0;
  font-size:12.5px;
  line-height:1.55;
  color:#606060;
}

.comparison-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;
}

.comparison-item{
  border-top:1px solid #dedede;
  padding-top:12px;
}

.comparison-image{
  aspect-ratio:4/3;
  margin-bottom:12px;
}

.comparison-item h3{
  margin:0 0 7px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  color:#777;
  letter-spacing:.07em;
}

.comparison-item p{
  margin:0;
  font-size:12.5px;
  line-height:1.6;
  color:#606060;
}

.observation-grid{
  display:grid;
  grid-template-columns:minmax(0,1.2fr) repeat(2,minmax(240px,.4fr));
  gap:34px;
}

.observation-main{
  font-size:24px;
  line-height:1.35;
  color:#484848;
}

.observation-side{
  border-left:1px solid #dedede;
  padding-left:20px;
}

.observation-side h3{
  margin:0 0 8px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#777;
}

.observation-side p{
  margin:0;
  font-size:13px;
  line-height:1.7;
  color:#606060;
}

.case-final{
  padding-top:60px;
}

.case-final-image{
  aspect-ratio:16/8.7;
}

.case-caption{
  max-width:700px;
  margin-top:10px;
  font-size:12px;
  color:#777;
}

/* responsive */
@media(max-width:980px){
  .case-shell{margin-left:0}
  .case-page{width:calc(100vw - 36px);padding:44px 0 80px}
  .case-meta,
  .project-visual-split,
  .reflection-grid,
  .apparatus-grid,
  .observation-grid{
    grid-template-columns:1fr;
  }
  .project-block-head,
  .experiment-heading,
  .experiment-question-band{
    grid-template-columns:1fr;
    gap:10px;
  }
  .sequence-strip,
  .comparison-grid{
    grid-template-columns:1fr;
  }
  .iteration-grid{
    grid-template-columns:1fr;
  }
  .system-diagram{
    grid-template-columns:1fr;
  }
  .system-arrow{
    transform:rotate(90deg);
  }
  .reflection-next,
  .observation-side{
    border-left:0;
    border-top:1px solid #dedede;
    padding-left:0;
    padding-top:16px;
  }
}

/* V14 Studies / Practice */
.process-block{margin-top:96px;padding-top:82px;border-top:1px solid #dedede}.compact-heading{margin-bottom:34px}.about-secondary{min-height:auto}.about-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:72px;padding-bottom:52px;border-bottom:1px solid #dedede}.about-lead{max-width:760px;margin:0 0 34px;font-size:18px;line-height:1.7;color:#505050}.about-side{display:flex;flex-direction:column;gap:32px;padding-left:26px;border-left:1px solid #dedede}.about-subsection{margin-bottom:26px}.about-subsection:last-child{margin-bottom:0}.about-subsection p{margin:6px 0 0;font-size:13px;line-height:1.6;color:#606060}.mini-recognition{margin-top:54px}.mini-recognition .recognition-media{height:250px}@media(max-width:980px){.about-grid{grid-template-columns:1fr;gap:34px}.about-side{border-left:0;border-top:1px solid #dedede;padding-left:0;padding-top:24px}}


/* ============================================================
   V15 — IMAGE-READY SLOTS + FULL RECOGNITION INSIDE ABOUT
   Replace JPG files in /images while keeping filenames unchanged.
   ============================================================ */

.image-slot{
  display:block;
  width:100%;
  object-fit:cover;
  background:#f2f2f0;
}

.feature-image,
.case-hero,
.case-final-image{
  object-fit:cover;
}

.project-visual,
.sequence-frame,
.apparatus-image,
.iteration-image,
.comparison-image,
.technical-media,
.recognition-media,
.sketch{
  object-fit:cover;
}

.about-recognition{
  margin-top:94px;
  padding-top:82px;
  border-top:1px solid #dedede;
}

/* Preserve the large alternating Recognition layout even though
   Recognition now lives under the About top-level menu. */
.about-recognition .recognition-list{
  gap:54px;
}

.about-recognition .recognition-row{
  grid-template-columns:1.05fr .95fr;
  gap:44px;
  align-items:center;
}

.about-recognition .recognition-media{
  height:290px;
}

.about-recognition .recognition-copy h3{
  font-size:40px;
  line-height:1;
  margin:6px 0 12px;
}

.about-recognition .recognition-copy p{
  max-width:390px;
}

.recognition-heading{
  margin-bottom:44px;
}

@media(max-width:980px){
  .about-recognition{
    margin-top:66px;
    padding-top:58px;
  }

  .about-recognition .recognition-row,
  .about-recognition .recognition-row.reverse{
    grid-template-columns:1fr;
  }

  .about-recognition .recognition-row.reverse .recognition-media,
  .about-recognition .recognition-row.reverse .recognition-copy{
    order:initial;
  }

  .about-recognition .recognition-media{
    height:auto;
    aspect-ratio:16/9;
  }
}


/* ============================================================
   V16 — HOME AS ABOUT / RECOGNITION TAB / SKETCHES SPACING FIX
   ============================================================ */

/* Home/hero now acts as the About area via the name link. */
#top{
  scroll-margin-top:0;
}

/* Studies should end clearly after the Sketches block. */
#studies{
  padding-bottom:120px !important;
}

/* Sketches is visually a deliberate sub-section, not a bridge into Practice. */
.sketchbook-block{
  margin-top:120px !important;
  padding-top:86px !important;
  border-top:1px solid #dedede !important;
}

.sketchbook-block .compact-heading{
  margin-bottom:42px !important;
}

.sketchbook-block .sketch-grid{
  margin-bottom:0;
}

/* Give Practice a fresh start and prevent it from visually merging with Sketches. */
#practice{
  padding-top:118px !important;
  padding-bottom:116px !important;
  border-top:0;
}

#practice .section-heading{
  margin-bottom:54px;
}

#practice .technical-grid{
  row-gap:64px;
}

/* Recognition is now a full top-level section. Keep the large alternating layout. */
.recognition-section{
  padding-top:118px !important;
  padding-bottom:118px !important;
}

.recognition-section .section-heading{
  margin-bottom:56px;
}

.recognition-section .recognition-list{
  gap:64px;
}

.recognition-section .recognition-row{
  grid-template-columns:1.05fr .95fr;
  gap:48px;
  align-items:center;
}

.recognition-section .recognition-media{
  height:290px;
}

.recognition-section .recognition-copy h3{
  font-size:40px;
  line-height:1;
  margin:6px 0 12px;
}

.recognition-section .recognition-copy p{
  max-width:390px;
}

.press-strip{
  margin-top:84px;
  padding-top:30px;
  border-top:1px solid #dedede;
  display:grid;
  grid-template-columns:180px minmax(0,1fr);
  gap:34px;
  align-items:start;
}

.press-label{
  font-size:10px;
  letter-spacing:.08em;
  color:#777;
}

.press-links{
  display:flex;
  flex-wrap:wrap;
  gap:14px 28px;
  font-size:13px;
  color:#606060;
}

/* Old About wrappers are no longer used on the homepage. */
.about-secondary,
.about-recognition{
  display:none;
}

/* Mobile */
@media(max-width:980px){
  #studies{
    padding-bottom:76px !important;
  }

  .sketchbook-block{
    margin-top:78px !important;
    padding-top:58px !important;
  }

  #practice,
  .recognition-section{
    padding-top:78px !important;
    padding-bottom:82px !important;
  }

  .recognition-section .recognition-row,
  .recognition-section .recognition-row.reverse{
    grid-template-columns:1fr;
  }

  .recognition-section .recognition-row.reverse .recognition-media,
  .recognition-section .recognition-row.reverse .recognition-copy{
    order:initial;
  }

  .recognition-section .recognition-media{
    height:auto;
    aspect-ratio:16/9;
  }

  .press-strip{
    grid-template-columns:1fr;
    gap:12px;
    margin-top:56px;
  }
}


/* ============================================================
   V16.1 — SKETCH GRID OVERFLOW FIX
   Keep every sketch image inside its assigned CSS-grid cell.
   ============================================================ */

.sketchbook-block .sketch-grid{
  overflow:hidden;
  align-items:stretch;
}

.sketchbook-block .sketch-grid .sketch{
  width:100% !important;
  height:100% !important;
  min-width:0;
  min-height:0;
  object-fit:cover !important;
  overflow:hidden;
}

/* Give the next section a little guaranteed breathing room as well. */
.sketchbook-block{
  margin-bottom:36px;
}


/* V16.3 — Press removed from homepage */
.press-strip{
  display:none !important;
}


/* V16.4 — real user hero photo */
.hero-grid-portrait{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(280px,.58fr);gap:72px;align-items:end}
.hero-copy{min-width:0}
.hero-portrait{margin:0;align-self:end;justify-self:end;width:min(100%,360px)}
.hero-portrait img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center center}
.hero-meta-inline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:46px;padding-top:22px;border-top:1px solid #dedede}
.hero-meta-inline .meta-block p{margin:4px 0 0;font-size:12.5px;line-height:1.55}
@media(max-width:980px){.hero-grid-portrait{grid-template-columns:1fr;gap:38px}.hero-portrait{justify-self:start;width:min(72vw,360px)}.hero-meta-inline{grid-template-columns:1fr;gap:18px}}


/* V16.5 — show more of hero photo, adjust size */
.hero-grid-portrait{grid-template-columns:minmax(0,1.12fr) minmax(250px,.52fr) !important;gap:64px !important;align-items:end !important}
.hero-portrait{width:min(100%,330px) !important;align-self:end !important;justify-self:end !important}
.hero-portrait img{width:100% !important;height:auto !important;aspect-ratio:auto !important;object-fit:contain !important;object-position:center top !important;border:1px solid #e2e2df}
@media(max-width:980px){.hero-portrait{width:min(78vw,330px) !important}}


/* V16.6 — preserve the lower-resolution Tobin Prize panel image without hard cropping */
.recognition-media-contain{
  object-fit:contain !important;
  background:#111;
}


/* V16.7 — improvised-light hero + USITT image */
.hero-grid-portrait{grid-template-columns:minmax(0,1.12fr) minmax(250px,.54fr) !important;gap:64px !important;align-items:end !important}
.hero-portrait{width:min(100%,300px) !important;align-self:end !important;justify-self:end !important}
.hero-portrait img{width:100% !important;height:auto !important;aspect-ratio:auto !important;object-fit:contain !important;object-position:center top !important;border:1px solid #e2e2df;background:#fff}
.hero-caption{margin-top:10px;color:#666;font-size:11.5px;line-height:1.5}
.hero-caption .mono{font-size:10px;letter-spacing:.08em;color:#777}
@media(max-width:980px){.hero-portrait{width:min(78vw,300px) !important}.hero-caption{max-width:320px}}


/* V16.8 tweaks */
.hero-portrait{width:min(100%,320px) !important}
.hero-portrait img{background:#fafafa !important}
@media(max-width:980px){.hero-portrait{width:min(80vw,320px) !important}}


/* ALONE — ARCHIVAL MATERIAL ------------------------------------ */
.archive-material{
  padding:46px 0 72px;
  border-bottom:1px solid #dedede;
}
.archive-material-head{
  display:grid;
  grid-template-columns:220px minmax(0,1fr);
  gap:44px;
  margin-bottom:34px;
}
.archive-material-head h2{
  margin:0 0 8px;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:22px;
  line-height:1.15;
  font-weight:500;
  letter-spacing:-.015em;
  color:#444;
}
.archive-material-head p{
  margin:0;
  max-width:720px;
  font-size:12.5px;
  line-height:1.65;
  color:#777;
}
.archive-stack{
  margin-left:264px;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:26px;
  align-items:start;
}
.archive-item{
  margin:0;
  min-width:0;
}
.archive-item img{
  display:block;
  width:100%;
  height:clamp(300px,27vw,390px);
  object-fit:contain;
  object-position:center;
  background:#f3f3f1;
  border:1px solid #e2e2df;
}
.archive-item-operation{
  width:auto;
}
.archive-item-operation img{
  background:#090909;
  filter:contrast(1.10) brightness(.95);
}
.archive-item figcaption{
  display:flex;
  justify-content:space-between;
  gap:18px;
  margin-top:10px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  line-height:1.4;
  letter-spacing:.04em;
  text-transform:uppercase;
  color:#606060;
}
.archive-item figcaption small{
  font-size:9px;
  letter-spacing:.02em;
  text-transform:none;
  color:#909090;
  text-align:right;
}
@media(max-width:980px){
  .archive-material-head{grid-template-columns:1fr;gap:10px}
  .archive-stack{margin-left:0;grid-template-columns:1fr;gap:32px}
  .archive-item img{height:auto;max-height:none}
}


/* ALONE — FULL PERFORMANCE DOCUMENTATION ---------------------- */
.performance-documentation{
  padding:72px 0;
  border-bottom:1px solid #dedede;
}
.performance-documentation-head{
  display:grid;
  grid-template-columns:220px minmax(0,1fr);
  gap:44px;
  margin-bottom:32px;
}
.performance-documentation-head h2{
  margin:0 0 8px;
  font-family:"IBM Plex Sans",sans-serif;
  font-size:22px;
  line-height:1.15;
  font-weight:500;
  letter-spacing:-.015em;
  color:#444;
}
.performance-documentation-head p{
  margin:0;
  max-width:720px;
  font-size:12.5px;
  line-height:1.65;
  color:#777;
}
.performance-video{
  display:block;
  width:calc(100% - 264px);
  margin-left:264px;
  aspect-ratio:16/9;
  background:#0a0a0a;
  border:1px solid #dedede;
}
.performance-video-meta{
  width:calc(100% - 264px);
  margin:10px 0 0 264px;
  display:flex;
  justify-content:space-between;
  gap:20px;
  font-family:"IBM Plex Mono",monospace;
  font-size:10px;
  line-height:1.4;
  letter-spacing:.04em;
  text-transform:uppercase;
  color:#666;
}
@media(max-width:980px){
  .performance-documentation-head{grid-template-columns:1fr;gap:10px}
  .performance-video,.performance-video-meta{width:100%;margin-left:0}
}


/* V18 — Visual studies after Practice, larger costume work */
.visual-studies-section{padding-top:104px}
.visual-studies-grid{
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  gap:34px 28px;
  align-items:start;
}
.visual-study{margin:0;min-width:0}
.visual-study img{display:block;width:100%;background:#f5f2ed}
.visual-study figcaption{display:flex;justify-content:space-between;gap:20px;align-items:baseline;margin-top:10px;padding-top:8px;border-top:1px solid #dedede}
.visual-study figcaption span{font-size:12px;letter-spacing:.05em;text-transform:uppercase}
.visual-study figcaption small{font-size:11px;color:var(--muted);text-align:right}

/* First row: process + observation, no unused columns */
.visual-study-process{grid-column:span 7}
.visual-study-process img{aspect-ratio:1.85/1;object-fit:cover}
.visual-study-observation{grid-column:span 5}
.visual-study-observation img{aspect-ratio:1.52/1;object-fit:cover}

/* Second row: make the finished costume rendering the visual anchor */
.visual-study-costume{grid-column:span 6}
.visual-study-costume img{display:block;width:min(100%,620px);height:auto;object-fit:contain;background:#fff;margin:0 auto}
.visual-study-side-stack{grid-column:span 6;display:grid;grid-template-columns:1fr;gap:34px;align-content:start}
.visual-study-hanbok img{aspect-ratio:4/5;object-fit:cover;object-position:center center;background:#faf9f7}
.visual-study-color img{aspect-ratio:1/1;object-fit:cover}

@media(max-width:980px){
  .visual-studies-section{padding-top:76px}
  .visual-study-process,.visual-study-observation,.visual-study-costume,.visual-study-side-stack{grid-column:1/-1}
  .visual-study-process img,.visual-study-observation img{aspect-ratio:16/10}
  .visual-study-costume img{width:min(100%,760px);margin:0 auto}
  .visual-study-side-stack{grid-template-columns:1fr 1fr;gap:22px}
}
@media(max-width:640px){
  .visual-study-side-stack{grid-template-columns:1fr}
}

/* V19 — compact Visual Studies */
.visual-studies-section{padding-top:88px}
.visual-studies-compact{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,.8fr);gap:28px;align-items:start}
.visual-study-observation-main img{width:100%;aspect-ratio:5/3;object-fit:cover;background:#f6f3ee}
.visual-study-compact-stack{display:grid;grid-template-columns:1fr;gap:24px}
.visual-study-process-compact img{width:100%;aspect-ratio:1.95/1;object-fit:cover}
.visual-study-color-compact img{width:100%;aspect-ratio:1.55/1;object-fit:cover;object-position:center 45%}
@media(max-width:980px){.visual-studies-compact{grid-template-columns:1fr}.visual-study-compact-stack{grid-template-columns:1fr 1fr}.visual-study-observation-main img{aspect-ratio:16/10}}
@media(max-width:640px){.visual-study-compact-stack{grid-template-columns:1fr}}


/* Visual Studies v6: compact, balanced, full-artwork presentation */
.visual-studies-section{padding-top:82px}
.visual-studies-balanced{
  display:grid;
  grid-template-columns:1.05fr 1.12fr .83fr;
  gap:24px;
  align-items:start;
}
.visual-studies-balanced .visual-study{min-width:0}
.visual-media{
  width:100%;
  height:300px;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:#f6f4f0;
}
.visual-media img{display:block;max-width:100%;max-height:100%;width:auto;height:auto}
.visual-media-observation img{width:100%;height:100%;object-fit:cover}
.visual-media-material{background:#fff}
.visual-media-material img{width:100%;height:100%;object-fit:contain}
.visual-media-color{background:#fff}
.visual-media-color img{width:100%;height:100%;object-fit:contain}
.visual-form-heading{
  margin-top:34px;
  padding-top:14px;
  border-top:1px solid #dedede;
  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
}
.visual-form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
  margin-top:14px;
}
.visual-form-media{
  height:235px;
  background:#faf9f7;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.visual-form-media img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
@media(max-width:980px){
  .visual-studies-balanced{grid-template-columns:1fr 1fr}
  .visual-study-observation-balanced{grid-column:1/-1}
  .visual-media{height:300px}
  .visual-media-observation{height:360px}
}
@media(max-width:640px){
  .visual-studies-balanced,.visual-form-row{grid-template-columns:1fr}
  .visual-study-observation-balanced{grid-column:auto}
  .visual-media,.visual-media-observation{height:auto;min-height:0}
  .visual-media img{width:100%;height:auto;max-height:none;object-fit:contain}
  .visual-form-media{height:280px}
}


/* V20 — quieter Visual Studies + text-only Recognition */
.visual-studies-section{padding-top:78px !important;padding-bottom:84px !important}
.visual-studies-heading{margin-bottom:30px !important}
.visual-studies-strip{display:grid;grid-template-columns:1fr 1.12fr .88fr;gap:22px;align-items:start}
.visual-strip-card{min-width:0;margin:0}
.visual-strip-media{height:235px;background:#faf9f6;display:flex;align-items:center;justify-content:center;overflow:hidden}
.visual-strip-media img{display:block;max-width:100%;max-height:100%;width:auto;height:auto}
.visual-strip-observation img{width:100%;height:100%;object-fit:contain;padding:6px;box-sizing:border-box}
.visual-strip-material{background:#fff}.visual-strip-material img{width:100%;height:100%;object-fit:contain}
.visual-strip-color{background:#fff}.visual-strip-color img{width:100%;height:100%;object-fit:contain}
.visual-strip-card figcaption,.visual-form-mini figcaption{margin-top:10px;display:flex;flex-direction:column;gap:3px}
.visual-strip-card figcaption span,.visual-form-mini figcaption span{font-size:13px;color:var(--ink)}
.visual-strip-card figcaption small,.visual-form-mini figcaption small{font-size:10px;line-height:1.35;color:var(--muted)}
.visual-form-compact{margin-top:28px;padding-top:14px;border-top:1px solid #dedede;display:grid;grid-template-columns:minmax(130px,.62fr) 1fr 1fr;gap:20px;align-items:start}
.visual-form-compact-label{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);padding-top:4px}
.visual-form-mini{margin:0;display:grid;grid-template-columns:108px 1fr;gap:12px;align-items:center;min-width:0}
.visual-form-mini-media{height:126px;background:#faf9f7;display:flex;align-items:center;justify-content:center;overflow:hidden}
.visual-form-mini-media img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
.visual-form-mini figcaption{margin-top:0}

.recognition-text-only{padding-top:88px !important;padding-bottom:92px !important}
.recognition-text-only .section-heading{margin-bottom:30px !important}
.recognition-text-list{border-top:1px solid #d9d9d9}
.recognition-text-row{display:grid;grid-template-columns:74px 110px minmax(0,1fr);gap:18px;padding:19px 0;border-bottom:1px solid #dedede;align-items:baseline}
.recognition-year{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
.recognition-kind{font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.recognition-item{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.2fr);gap:22px;align-items:baseline}
.recognition-item strong{font-weight:500;font-size:15px;line-height:1.3}
.recognition-item span{font-size:12px;line-height:1.5;color:#666}
@media(max-width:980px){
  .visual-studies-strip{grid-template-columns:1fr 1fr}.visual-strip-card:last-child{grid-column:1/-1}.visual-strip-card:last-child .visual-strip-media{height:250px}
  .visual-form-compact{grid-template-columns:1fr 1fr}.visual-form-compact-label{grid-column:1/-1}
  .recognition-item{grid-template-columns:1fr;gap:4px}
}
@media(max-width:640px){
  .visual-studies-strip{grid-template-columns:1fr}.visual-strip-card:last-child{grid-column:auto}.visual-strip-media,.visual-strip-card:last-child .visual-strip-media{height:auto;min-height:0}.visual-strip-media img{width:100%;height:auto;max-height:none;object-fit:contain}
  .visual-form-compact{grid-template-columns:1fr}.visual-form-mini{grid-template-columns:92px 1fr}.visual-form-mini-media{height:112px}
  .recognition-text-row{grid-template-columns:58px 1fr;gap:10px 16px}.recognition-kind{grid-column:2}.recognition-item{grid-column:2}
}


/* Visual Studies v8: editorial, natural-ratio layout */
.visual-studies-editorial-section{padding-top:82px !important;padding-bottom:86px !important}
.visual-studies-editorial-section .visual-studies-heading{margin-bottom:34px !important}
.visual-editorial-grid{
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:28px;
  row-gap:38px;
  align-items:start;
}
.visual-editorial-item{margin:0;min-width:0}
.visual-editorial-item img{display:block;width:100%;height:auto;background:#faf9f7}
.visual-editorial-item figcaption{
  display:flex;justify-content:space-between;gap:16px;align-items:baseline;
  margin-top:9px;padding-top:7px;border-top:1px solid #dedede
}
.visual-editorial-item figcaption span{font-size:12px;letter-spacing:.035em;color:var(--ink)}
.visual-editorial-item figcaption small{font-size:10px;line-height:1.35;color:var(--muted);text-align:right}
.visual-editorial-material{grid-column:1/8;grid-row:1}
.visual-editorial-observation{grid-column:9/13;grid-row:1;margin-top:58px}
.visual-editorial-color{grid-column:1/5;grid-row:2;margin-top:-8px}
.visual-editorial-costume{grid-column:6/10;grid-row:2;margin-top:34px}
.visual-editorial-hanbok{grid-column:10/13;grid-row:2;margin-top:-14px}
.visual-editorial-costume img,.visual-editorial-hanbok img{background:#fff}
.visual-editorial-hanbok img{width:90%;margin-left:auto;margin-right:auto;object-fit:contain}
.visual-editorial-costume img{transform:translate(-51px,-24px)}
@media(max-width:980px){
  .visual-editorial-costume img{transform:none}
  .visual-editorial-hanbok img{width:100%}
  .visual-editorial-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 22px}
  .visual-editorial-material{grid-column:1/-1;grid-row:auto}
  .visual-editorial-observation,.visual-editorial-color,.visual-editorial-costume,.visual-editorial-hanbok{grid-column:auto;grid-row:auto;margin-top:0}
}
@media(max-width:640px){
  .visual-editorial-grid{grid-template-columns:1fr;gap:28px}
  .visual-editorial-material,.visual-editorial-observation,.visual-editorial-color,.visual-editorial-costume,.visual-editorial-hanbok{grid-column:1;grid-row:auto;margin-top:0}
  .visual-editorial-item figcaption{align-items:flex-start}
}

/* ============================================================
   V15 — Compact Technical Practice
   Technical roles are intentionally smaller than the research work.
   ============================================================ */
#practice.technical-practice-section{
  padding-top:96px !important;
  padding-bottom:104px !important;
}

#practice.technical-practice-section .section-heading{
  margin-bottom:38px;
}

#practice .technical-grid-compact{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:24px;
}

#practice .technical-item{
  min-width:0;
}

#practice .technical-media{
  display:block;
  width:100%;
  aspect-ratio:4/3;
  height:auto;
  object-fit:cover;
  margin-bottom:14px;
}

#practice .technical-item h3{
  font-size:22px;
  line-height:1.08;
  margin:0 0 7px;
}

#practice .technical-item .role{
  font-size:10px;
  line-height:1.45;
  letter-spacing:.075em;
  margin-bottom:7px;
}

#practice .technical-item p:last-child{
  font-size:11.5px;
  line-height:1.55;
}

#practice .technical-credit{
  color:#85807a;
}

/* Hoffmann uses a programming/data graphic rather than a production image,
   so the visual cannot be mistaken for Seojung's lighting design. */
#practice .technical-data-card{
  box-sizing:border-box;
  position:relative;
  overflow:hidden;
  padding:18px;
  background:#0b0b0b;
  color:#f1f1ed;
  border:1px solid #272727;
  font-family:'IBM Plex Mono', monospace;
}

#practice .data-card-top{
  display:flex;
  justify-content:space-between;
  gap:12px;
  font-size:9px;
  line-height:1;
  letter-spacing:.14em;
  color:#9b9b96;
}

#practice .data-card-title{
  position:absolute;
  left:18px;
  top:50%;
  transform:translateY(-52%);
  z-index:2;
  font-size:clamp(19px,2vw,30px);
  line-height:.96;
  letter-spacing:-.035em;
  font-family:'IBM Plex Sans', sans-serif;
  font-weight:500;
}

#practice .data-card-lines{
  position:absolute;
  inset:42px 18px 38px 48%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:10px;
  opacity:.8;
}

#practice .data-card-lines i{
  display:block;
  height:1px;
  background:#54544f;
  transform-origin:left center;
}
#practice .data-card-lines i:nth-child(1){width:88%;}
#practice .data-card-lines i:nth-child(2){width:62%;}
#practice .data-card-lines i:nth-child(3){width:100%;}
#practice .data-card-lines i:nth-child(4){width:74%;}
#practice .data-card-lines i:nth-child(5){width:46%;}

#practice .data-card-foot{
  position:absolute;
  left:18px;
  right:18px;
  bottom:15px;
  font-size:8px;
  line-height:1.2;
  letter-spacing:.08em;
  color:#777772;
}

@media(max-width:980px){
  #practice .technical-grid-compact{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media(max-width:640px){
  #practice.technical-practice-section{
    padding-top:76px !important;
    padding-bottom:84px !important;
  }
  #practice .technical-grid-compact{
    grid-template-columns:1fr;
    gap:38px;
  }
  #practice .technical-item h3{
    font-size:24px;
  }
}


/* ============================================================
   V16 — Technical Practice metadata hierarchy + Visual Studies coda
   ============================================================ */
#practice .technical-credit-stack h3{
  margin-bottom:10px;
}
#practice .practice-org{
  margin:0 0 3px !important;
  font-size:12px !important;
  line-height:1.35 !important;
  font-weight:600;
  letter-spacing:.015em;
  color:#1b1b1a;
}
#practice .practice-location{
  margin:0 0 15px !important;
  font-size:10.5px !important;
  line-height:1.45 !important;
  color:#77736e;
}
#practice .practice-meta{
  display:grid;
  grid-template-columns:minmax(82px,.7fr) minmax(0,1.7fr);
  gap:10px;
  padding-top:8px;
  margin-top:8px;
  border-top:1px solid rgba(0,0,0,.12);
}
#practice .practice-meta span{
  font-family:'IBM Plex Mono',monospace;
  font-size:8px;
  line-height:1.35;
  letter-spacing:.08em;
  color:#8d8882;
}
#practice .practice-meta strong{
  font-size:10.5px;
  line-height:1.45;
  font-weight:500;
  color:#292725;
}
#practice .technical-data-image{
  background:#0b0b0b;
  object-fit:cover;
}
#practice .hoffmann-card .data-card-foot{
  letter-spacing:.10em;
}

/* Visual Studies intentionally follows Recognition as a quieter visual coda. */
#visual-studies.visual-studies-editorial-section{
  border-top:1px solid rgba(0,0,0,.10);
}

@media(max-width:640px){
  #practice .practice-meta{
    grid-template-columns:92px minmax(0,1fr);
  }
  #practice .practice-org{font-size:12.5px !important;}
  #practice .practice-location{font-size:11px !important;}
  #practice .practice-meta strong{font-size:11px;}
}

/* Recognition role emphasis */
.recognition-item span b{font-weight:500;color:#3f3f3f}

/* Recognition v2 — consistent two-line detail hierarchy */
.recognition-detail{
  display:flex;
  flex-direction:column;
  gap:4px;
  min-width:0;
}
.recognition-detail .recognition-main,
.recognition-detail .recognition-sub{
  display:block;
}
.recognition-detail .recognition-main{
  font-size:12px;
  line-height:1.45;
  color:#4f4f4f;
}
.recognition-detail .recognition-sub{
  font-size:11px;
  line-height:1.45;
  color:#777;
}
.recognition-detail .recognition-sub b{
  color:#555;
  font-weight:500;
}
.recognition-text-row{
  align-items:start;
}
.recognition-item{
  align-items:start;
}
@media(max-width:980px){
  .recognition-detail{gap:3px}
}
